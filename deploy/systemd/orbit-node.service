[Unit]
Description=Orbit Blockchain Node
Documentation=https://github.com/Night-Traders-Dev/SageChain
After=network.target
Wants=network.target

[Service]
Type=simple
User=orbit
Group=orbit
WorkingDirectory=/opt/orbit
ExecStart=/usr/local/bin/sage-c /opt/orbit/orbit/node/main.sage --config /etc/orbit/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orbit-node

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/orbit/data /opt/orbit/logs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Environment
Environment=RUST_LOG=info
Environment=ORBIT_CONFIG=/etc/orbit/config.toml

[Install]
WantedBy=multi-user.target